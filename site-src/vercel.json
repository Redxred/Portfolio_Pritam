    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pritamnathdipta.site" }],
      "destination": "https://www.pritamnathdipta.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pritamnathdipta.site" }],
      "destination": "https://www.pritamnathdipta.online/:path*",
      "permanent": true
    }
  ]
}
